# Local: run `pnpm --filter @signal/db dev` then paste the printed DATABASE_URL.
# Hosted Prisma Postgres: use the pooled URL here and the direct URL in DIRECT_URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Better Auth
BETTER_AUTH_SECRET="replace-with-32-plus-random-characters"
BETTER_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# AES-256-GCM master key: 32 bytes, base64-encoded
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Shared secret for POST /api/internal/jobs/drain
JOB_DRAIN_SECRET="replace-with-long-random-string"

# Optional: used by the playground fixture when no org key is stored
OPENAI_API_KEY=""
